<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.ShadowCopyView"
             x:DataType="tools:ShadowCopyTool">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="toolbar" IsVisible="{Binding !!Snapshots.Count}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="tb" VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:CinderIcon Data="{x:Static c:Icons.Clock}" Width="14" Height="14" />
                        <TextBlock Text="列出快照" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <c:ExportButton Grid.Column="2" ExportCommand="{Binding ExportCommand}" VerticalAlignment="Center"
                                IsVisible="{Binding Snapshots.Count}" />
            </Grid>
        </Border>
        <Panel Grid.Row="1">
            <DataGrid ItemsSource="{Binding Snapshots}" AutoGenerateColumns="False" IsReadOnly="True"
                      IsVisible="{Binding Snapshots.Count}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="快照" Binding="{Binding Id}" Width="*"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="卷" Binding="{Binding Origin}" Width="*"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="创建时间（UTC）" Binding="{Binding CreatedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="170"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="{Binding EmptyTitle}" IsVisible="{Binding !Snapshots.Count}"
                          Message="列出当前这台计算机上存在的各时间点快照：Windows 上的卷影副本（Volume Shadow Copies），Linux 上的 btrfs、LVM 和 ZFS 快照。被删除或被改动文件的较早版本常常还留存在其中。列出快照需要管理员或 root 权限。">
                <Button Classes="accent" Height="30" Padding="14,0" Content="列出快照" Command="{Binding RefreshCommand}" />
            </c:EmptyState>
        </Panel>
        <Border Grid.Row="2" Classes="footer">
            <TextBlock Text="{Binding StatusLine}" />
        </Border>
    </Grid>
</UserControl>
