<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.HashSetsView"
             x:DataType="tools:HashSetsTool">
    <!-- Open a hash set, then check a hash against it. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Content="打开哈希样本集…" Command="{Binding PickDatabaseCommand}"
                            ToolTip.Tip="打开你之前创建的哈希样本集数据库（.db）。" />
                    <Button Classes="tb" Content="新建哈希样本集…" Command="{Binding NewDatabaseCommand}"
                            ToolTip.Tip="先创建一个空的哈希样本集数据库，再把列表导入其中。" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="path" Margin="14,0" Text="{Binding DatabasePath}"
                           ToolTip.Tip="{Binding DatabasePath}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding HasDatabase}">
                    <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding ImportNsrlCommand.IsRunning}" />
                    <Button Classes="tb" Content="导入 NSRL 列表…" Command="{Binding ImportNsrlCommand}"
                            ToolTip.Tip="把 NSRL 精简版 CSV（NSRLFile.txt）中的哈希添加到此哈希样本集。" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Row="1">
            <ScrollViewer IsVisible="{Binding HasDatabase}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" LineHeight="19" MaxWidth="640" HorizontalAlignment="Left"
                               Text="粘贴一个文件哈希，看它是否在这个哈希样本集中。命中已知良性列表（例如 NSRL）通常说明该文件是标准软件，可以先放到一边；命中你自己的已知恶意列表则说明它需要关注。" />
                    <Grid ColumnDefinitions="120,Auto,*,Auto">
                        <TextBlock Text="哈希" Classes="label" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}" MinWidth="104" />
                        <TextBox Grid.Column="2" Margin="6,0" Text="{Binding Query}" Watermark="粘贴哈希（十六进制）"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Return" Command="{Binding LookupCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="3" Classes="accent" Height="30" Padding="14,0" Content="查询"
                                Command="{Binding LookupCommand}" />
                    </Grid>
                    <Border Background="{DynamicResource CinderSurface2Brush}" CornerRadius="8" Padding="16,14" Margin="120,0,0,0"
                            IsVisible="{Binding VerdictLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Text="{Binding VerdictLine}" FontSize="13" TextWrapping="Wrap" LineHeight="19" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="尚未打开哈希样本集" IsVisible="{Binding !HasDatabase}"
                          Message="哈希样本集是一份你已掌握的文件哈希列表：可以是 NSRL 的标准软件列表，也可以是你自己的已知恶意文件列表。打开一份即可用其核查哈希。文件系统工具会使用同一份哈希样本集把文件标记为已知。">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Height="30" Padding="14,0" Content="打开哈希样本集…" Command="{Binding PickDatabaseCommand}" />
                    <Button Classes="tb" Height="30" Padding="14,0" Content="新建哈希样本集…" Command="{Binding NewDatabaseCommand}" />
                </StackPanel>
            </c:EmptyState>
        </Panel>

        <Border Grid.Row="2" Classes="footer">
            <TextBlock Text="{Binding StatusLine}" />
        </Border>
    </Grid>
</UserControl>
