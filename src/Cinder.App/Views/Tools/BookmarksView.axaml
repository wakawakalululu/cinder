<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.BookmarksView"
             x:DataType="tools:BookmarksTool">
    <!-- Everything flagged in this case, in one list. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Command="{Binding RefreshCommand}" ToolTip.Tip="从案件文件重新读取这份列表。">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="14" Height="14" />
                            <TextBlock Text="重新读取" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tb" Content="移除所选" Command="{Binding DeleteSelectedCommand}"
                            IsVisible="{Binding Bookmarks.Count}"
                            ToolTip.Tip="撤销这条发现。移除操作本身会记入监管链日志，因此不会有任何东西被悄悄删掉。" />
                </StackPanel>
                <c:ExportButton Grid.Column="2" ExportCommand="{Binding ExportCommand}" VerticalAlignment="Center"
                                IsVisible="{Binding Bookmarks.Count}" />
            </Grid>
        </Border>

        <Panel Grid.Row="1">
            <DataGrid ItemsSource="{Binding Bookmarks}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding Bookmarks.Count}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="56"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="标记时间（UTC）" Binding="{Binding CreatedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="170"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="取证员" Binding="{Binding Examiner}" Width="110" />
                    <DataGridTextColumn Header="工具" Binding="{Binding Tool}" Width="120" />
                    <DataGridTextColumn Header="内容" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="2*" />
                    <DataGridTextColumn Header="检材" Binding="{Binding EvidencePath}" Width="*"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                </DataGrid.Columns>
            </DataGrid>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="尚无书签" IsVisible="{Binding !Bookmarks.Count}"
                          Message="当任何工具中的某一行值得记录时，选中它并选择书签。它会连同你的备注、所用工具和来源检材一起保存到当前打开的案件，并显示在这里。报告功能会把这份列表整理成编号的附件（Exhibit）。加入书签需要先打开案件。" />
        </Panel>

        <Border Grid.Row="2" Classes="footer">
            <TextBlock Text="{Binding StatusLine}" />
        </Border>
    </Grid>
</UserControl>
