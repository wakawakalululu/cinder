<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.PluginsView"
             x:DataType="tools:PluginsTool">
    <!-- Off by default. Turn plugins on, pick a folder, then trust files one at a time. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="toolbar" IsVisible="{Binding PluginsEnabled}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Command="{Binding PickFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Folder}" Width="14" Height="14" />
                            <TextBlock Text="插件文件夹…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="accent" Height="26" Padding="12,0" Content="信任并加载" Command="{Binding TrustSelectedCommand}"
                            IsVisible="{Binding CanTrustSelected}"
                            ToolTip.Tip="将这一文件本体（按其 SHA-256）记录为个人配置中的受信任项，然后运行它。若文件发生变化，需重新信任。" />
                    <Button Classes="tb" Content="移除信任" Command="{Binding RevokeSelectedCommand}"
                            IsVisible="{Binding CanRevokeSelected}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="path" Margin="14,0" Text="{Binding Folder}" ToolTip.Tip="{Binding Folder}" />
                <Button Grid.Column="2" Classes="tb" VerticalAlignment="Center" Content="关闭插件"
                        Command="{Binding DisablePluginsCommand}" />
            </Grid>
        </Border>

        <Panel Grid.Row="1">
            <DataGrid ItemsSource="{Binding Loaded}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      IsVisible="{Binding Loaded.Count}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="220" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="签名者" Binding="{Binding SignatureDisplay}" Width="240" />
                    <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="*"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="问题" Binding="{Binding Error}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Plugins switched off (the default). -->
            <c:EmptyState Icon="{Binding IconGeometry}" Title="插件已关闭" IsVisible="{Binding !PluginsEnabled}"
                          Message="插件是扩展 Cinder 功能的 .dll 文件。它对本机和检材的访问权限与 Cinder 本身相同，因此插件默认保持关闭，直到你手动开启；而且即使开启，也要先信任具体文件，任何插件才会运行。信任信息保存在你的用户配置中，而不是插件文件夹里。">
                <Button Classes="accent" Height="30" Padding="14,0" Content="开启插件" Command="{Binding EnablePluginsCommand}" />
            </c:EmptyState>

            <!-- On, but nothing listed yet. -->
            <c:EmptyState Icon="{Binding IconGeometry}" Title="尚未列出插件" IsVisible="{Binding ShowPickFolder}"
                          Message="选择插件所在的文件夹。每个 .dll 都会连同其 SHA-256 和签名者一起列出。你未信任的文件会显示为未信任，且不会运行；核实其来源后，选中它并选择「信任并加载」。">
                <Button Classes="accent" Height="30" Padding="14,0" Content="插件文件夹…" Command="{Binding PickFolderCommand}" />
            </c:EmptyState>
        </Panel>

        <Border Grid.Row="2" Classes="footer">
            <TextBlock Text="{Binding StatusLine}" />
        </Border>
    </Grid>
</UserControl>
