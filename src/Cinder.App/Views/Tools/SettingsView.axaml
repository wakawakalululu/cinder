<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.SettingsView"
             x:DataType="tools:SettingsTool">
    <!-- The settings themselves, on the page. This used to be a screen holding one button that
         opened a dialog with the same content. Only settings that change something are shown. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,10" Background="{DynamicResource CinderSurface0Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Height="30" Padding="16,0" Content="保存设置" Command="{Binding SaveCommand}" />
                <Button Classes="tb" Height="30" Padding="12,0" Content="放弃更改" Command="{Binding ReloadCommand}"
                        ToolTip.Tip="把所有字段恢复为已保存的值" />
                <TextBlock Text="{Binding StatusLine}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextWrapping="Wrap" MaxWidth="760"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                           IsVisible="{Binding !Form.HasSaveError}" />
                <TextBlock Text="{Binding Form.SaveError}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextWrapping="Wrap" MaxWidth="760"
                           Foreground="{DynamicResource CinderDangerBrush}"
                           IsVisible="{Binding Form.HasSaveError}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
            <Grid ColumnDefinitions="*,*" MaxWidth="1240" HorizontalAlignment="Left" Margin="24,20,24,24"
                  DataContext="{Binding Form}" x:DataType="vm:SettingsFormViewModel">

                <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,10,0">
                    <Border Classes="note" Padding="18,16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="外观" Classes="section" />
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="主题" />
                                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" MinWidth="200" />
                            </StackPanel>
                            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                       Text="“跟随系统”会采用这台电脑的浅色或深色设置。" />
                        </StackPanel>
                    </Border>

                    <Border Classes="note" Padding="18,16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="哈希样本集" Classes="section" />
                            <TextBlock Classes="muted" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                       Text="哈希样本集工具所使用的数据库。开启后，文件系统工具在列目录时还会对每个文件计算哈希，并标记为 Known（已知）、Notable（值得注意）或 Unknown（未知），便于过滤掉操作系统自带的标准文件。" />
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="数据库文件" />
                                <TextBox Text="{Binding HashSetDatabase}" Watermark="在哈希样本集工具中选择"
                                         FontFamily="{DynamicResource CinderFontFamilyMono}" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding HashFilesOnEnumerate}"
                                      Content="列出文件系统时同时计算文件哈希" />
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="跳过大于此大小的文件" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumericUpDown Value="{Binding HashSizeLimitMb}" Minimum="1" Maximum="4096" Increment="16" FormatString="0" Width="150" />
                                    <TextBlock Text="兆字节" Classes="label" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="note" Padding="18,16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="监管链" Classes="section" />
                            <TextBlock Classes="muted" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                       Text="可选。设置地址后，对监管链日志签名时还会请这个时间戳服务（RFC 3161）会签，使时间来自你无法控制的时钟。发送的只是你签名的哈希，绝无案件内容。" />
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="时间戳服务地址" />
                                <TextBox Text="{Binding TimestampAuthorityUrl}" Watermark="https://freetsa.org/tsr"
                                         FontFamily="{DynamicResource CinderFontFamilyMono}" />
                            </StackPanel>
                            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Text="留空则签名时不加时间戳。" />
                        </StackPanel>
                    </Border>

                    <Border Classes="note" Padding="18,16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="外部工具集成" Classes="section" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="tb" Height="26" Padding="10,0"
                                        Content="自动检测全部" Command="{Binding DetectAllExternalToolsCommand}" />
                            </Grid>
                            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                       Text="自动探测外部程序，供命令面板与相关功能调用。探测顺序：手动指定 → 程序目录 tools.json → 注册表 → 系统 PATH → 默认安装路径。仅读取，不安装、不联网。" />
                            <ItemsControl ItemsSource="{Binding ExternalToolRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ExternalToolRowVm">
                                        <Border BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,8" IsVisible="{Binding IsFound, Mode=OneWay}">
                                            <StackPanel Spacing="3">
                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Classes="status-dot ok" IsVisible="{Binding IsFound}" />
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="500" />
                                                        <TextBlock Text="{Binding Purpose}" Classes="dim" FontSize="11.5" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" Classes="dim" FontSize="11.5"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="tb" Height="26" Padding="10,0" Content="自动检测"
                                                                Command="{Binding DetectCommand}" />
                                                        <Button Classes="tb" Height="26" Padding="10,0" Content="浏览指定…"
                                                                Command="{Binding BrowseCommand}" />
                                                        <Button Classes="tb" Height="26" Padding="10,0" Content="清除"
                                                                Command="{Binding ClearOverrideCommand}"
                                                                IsVisible="{Binding OverridePath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding DetectedPath}" Classes="mono dim" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DetectedPath}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 未找到的工具也列出来，便于知道缺什么。 -->
                            <ItemsControl ItemsSource="{Binding ExternalToolRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ExternalToolRowVm">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3"
                                                    IsVisible="{Binding !IsFound}">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="status-dot warn" />
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="500" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Purpose}" Classes="dim" FontSize="11.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Classes="tb" Height="24" Padding="10,0" Content="浏览指定…" Margin="10,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding BrowseCommand}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16" Margin="10,0,0,0">
                    <Border Classes="note" Padding="18,16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="AI 助手" Classes="section" />
                            <TextBlock Classes="muted" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                       Text="AI 助手工具默认使用的模型。Cinder 不内置模型：请指向本机上正在运行的模型（Ollama、LM Studio）或托管服务。输入助手的任何内容都会发送到该地址。" />
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="模型运行位置" />
                                <ComboBox ItemsSource="{Binding AiProviderOptions}" SelectedItem="{Binding AiProviderId}" MinWidth="200" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="地址" />
                                <TextBox Text="{Binding AiEndpoint}" Watermark="http://localhost:11434（Ollama 默认；LM Studio 默认 http://localhost:1234）"
                                         FontFamily="{DynamicResource CinderFontFamilyMono}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="API 密钥（先填密钥，再获取模型列表；本地 Ollama/LM Studio 可留空）" />
                                <TextBox Text="{Binding AiApiKey}" PasswordChar="•" Watermark="仅托管服务需要" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="模型名称" />
                                <Grid ColumnDefinitions="*,Auto" >
                                    <AutoCompleteBox HorizontalAlignment="Stretch" Height="30"
                                                     ItemsSource="{Binding AiModelOptions}"
                                                     Text="{Binding AiModel, Mode=TwoWay}"
                                                     MinimumPrefixLength="0"
                                                     Watermark="先填好地址与密钥，点右侧“获取模型列表”自动填充" />
                                    <Button Grid.Column="1" Classes="tb" Height="30" Padding="12,0" Margin="8,0,0,0"
                                            Content="获取模型列表" Command="{Binding FetchModelsCommand}" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding AiStatusLine}" IsVisible="{Binding AiStatusLine, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Classes="dim" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Classes="dim" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                       Text="密钥保存在你的设置文件中，并按 Windows 账户加密。在 Linux 和 macOS 上仅做混淆，并非安全加密。" />
                        </StackPanel>
                    </Border>

                    <Border Classes="note" Padding="18,16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="设置存放位置" Classes="section" />
                            <SelectableTextBlock Text="{Binding SettingsPath}" Classes="mono" FontSize="12" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                            <TextBlock Classes="dim" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                       Text="本机当前用户账户对应一个设置文件。案件不会携带设置。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
