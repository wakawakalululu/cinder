<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.Tools.ConvertView"
             x:DataType="tools:ConvertTool">
    <!-- Task page: the inputs and the one action on the left; what it does, then its progress
         and result, on the right. -->
    <c:TaskPage>
        <StackPanel Spacing="18">
            <StackPanel>
                <TextBlock Classes="field-label" Text="要转换的镜像" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding Source}" Watermark="Raw、E01、AFF4、VHD 或 VHDX"
                             FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    <Button Grid.Column="1" Classes="tb" Margin="6,0,0,0" Height="28" Content="选择…" Command="{Binding PickSourceCommand}" />
                </Grid>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="field-label" Text="副本保存为" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding Output}" Watermark="一个新文件"
                             FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    <Button Grid.Column="1" Classes="tb" Margin="6,0,0,0" Height="28" Content="另存为…" Command="{Binding PickOutputCommand}" />
                </Grid>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="field-label" Text="副本格式" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" MinWidth="160" />
            </StackPanel>
            <CheckBox IsChecked="{Binding Overwrite}" Content="替换此路径下已有的镜像文件"
                      ToolTip.Tip="默认关闭。不勾选时，若该路径已有文件（包括此前失败运行留下的残余），转换将拒绝开始。" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Classes="accent" Height="30" Padding="14,0" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="15" Height="15" />
                        <TextBlock Text="转换镜像" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tb" Height="30" Padding="12,0" Content="停止转换"
                        Command="{Binding RunCancelCommand}" IsVisible="{Binding RunCommand.IsRunning}"
                        ToolTip.Tip="停止转换并删除未完成的输出" />
            </StackPanel>
        </StackPanel>

        <c:TaskPage.Aside>
            <StackPanel>
                <StackPanel IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Classes="section" Text="执行过程" Margin="0,0,0,14" />
                    <c:Step Number="1" Title="以镜像现有格式读取"
                            Text="Raw、E01、AFF4、VHD 和 VHDX 可互相转换。源以只读方式打开，不会被改动。" />
                    <c:Step Number="2" Title="以新格式写入相同的磁盘内容"
                            Text="副本只有在完成后才会以最终名称出现。" />
                    <c:Step Number="3" Title="校验副本"
                            Text="新文件会被回读，其哈希必须与写入内容完全一致，结果以「输出校验」形式报告。" />
                    <c:Step Number="4" Title="在可行时校验源"
                            Text="E01 或 AFF4 源带有采集时记录的哈希，会据此进行校验；raw、VHD 或 VHDX 源不带哈希，该项将报告为「无法校验」而非「通过」。" />
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="section" Text="结果" />
                    <StackPanel Spacing="8" IsVisible="{Binding RunCommand.IsRunning}">
                        <ProgressBar IsIndeterminate="True" />
                        <TextBlock Text="{Binding BytesConverted, StringFormat='{}{0:N0} bytes converted so far'}" Classes="mono dim" FontSize="12" />
                    </StackPanel>
                    <Border Classes="result">
                        <SelectableTextBlock Text="{Binding StatusLine}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </c:TaskPage.Aside>
    </c:TaskPage>
</UserControl>
