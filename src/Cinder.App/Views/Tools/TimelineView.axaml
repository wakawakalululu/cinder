<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.Tools.TimelineView"
             x:DataType="vm:TimelineToolViewModel">
    <!--
        Super-timeline. Toolbar: get events in (ingest) · act on them (bookmark, export).
        Filter bar wraps instead of colliding with the toolbar at narrow widths. Filters apply on
        Enter or Refresh, and Export writes what the applied filter matches. Histogram shows
        where the activity is; the grid is the first 5,000 matching events.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Height="44" Padding="14,0,12,0"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="accent" Height="26" Padding="10,0" Command="{Binding IngestFolderCommand}"
                            ToolTip.Tip="读取一个检材文件夹，把其中的事件日志、注册表、Prefetch、快捷方式、浏览器历史记录、邮件、回收站和 NTFS 日志事件加入时间线。">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Folder}" Width="14" Height="14" />
                            <TextBlock Text="导入文件夹…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tb" Content="停止" Command="{Binding IngestFolderCancelCommand}"
                            IsVisible="{Binding IsIngesting}"
                            ToolTip.Tip="停止读取。该文件夹中的任何内容都不会加入。" />
                    <Button Classes="tb icon" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="应用日期和筛选（在筛选框内按回车效果相同）。">
                        <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="14" Height="14" />
                    </Button>
                    <TextBlock Text="筛选已更改，按回车应用。" Classes="dim" FontSize="12"
                               VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding FiltersEdited}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" ToolTip.Tip="把选定的事件标记为当前案件中的一条发现。">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Bookmark}" Width="14" Height="14" />
                            <TextBlock Text="书签" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <TextBlock Text="为选定事件加入书签" Classes="section" />
                                    <TextBox Watermark="备注（可选）" Text="{Binding BookmarkNote}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                    <Button Classes="accent" HorizontalAlignment="Right" Content="添加书签"
                                            Command="{Binding BookmarkSelectedCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="tb" ToolTip.Tip="把符合当前筛选的全部事件（而不只是显示的行）导出为其他时间线工具可读取的格式。">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Download}" Width="14" Height="14" />
                            <TextBlock Text="导出" VerticalAlignment="Center" />
                            <c:CinderIcon Data="{x:Static c:Icons.ChevronDown}" Width="12" Height="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Timesketch JSONL — 适合大型时间线" Command="{Binding ExportCommand}" CommandParameter="jsonl" />
                                <MenuItem Header="Timesketch CSV" Command="{Binding ExportCommand}" CommandParameter="csv" />
                                <MenuItem Header="Sleuth Kit bodyfile — mactime / Autopsy / Plaso" Command="{Binding ExportCommand}" CommandParameter="body" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="ghost icon" ToolTip.Tip="更多">
                        <TextBlock Text="⋯" FontSize="16" Margin="0,-4,0,0" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="清空时间线" Command="{Binding ClearCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Filters ===== -->
        <Border Grid.Row="1" Padding="14,8,14,10" Background="{DynamicResource CinderSurface1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.KeyBindings>
                    <KeyBinding Gesture="Return" Command="{Binding RefreshCommand}" />
                </WrapPanel.KeyBindings>
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > StackPanel">
                        <Setter Property="Margin" Value="0,2,14,2" />
                        <Setter Property="Spacing" Value="4" />
                    </Style>
                </WrapPanel.Styles>
                <StackPanel>
                    <TextBlock Text="从" Classes="section" />
                    <DatePicker SelectedDate="{Binding From, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="到" Classes="section" />
                    <DatePicker SelectedDate="{Binding To, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="用户" Classes="section" />
                    <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Watermark="任意" Width="130" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="来源" Classes="section" />
                    <TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" Watermark="evtx、浏览器…" Width="170"
                             ToolTip.Tip="来源名称的一部分。多个关键词用逗号分隔，例如 evtx, prefetch。" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="包含" Classes="section" />
                    <TextBox Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" Watermark="摘要中的文本" Width="190" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="ATT&amp;CK" Classes="section" />
                    <AutoCompleteBox Text="{Binding MitreFilter}"
                                     ItemsSource="{Binding KnownMitreIds}"
                                     FilterMode="Contains"
                                     Watermark="T1078, TA0002…"
                                     Width="170"
                                     ToolTip.Tip="技术或战术 ID 的前缀。导入时会依据 Windows 事件 ID、Sysmon、PowerShell 日志、Prefetch、UserAssist 和回收站自动为事件打上标签。" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===== Histogram ===== -->
        <Border Grid.Row="2" Height="64" Padding="14,10,14,6" IsVisible="{Binding Events.Count}">
            <ItemsControl ItemsSource="{Binding Histogram}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Margin="1,0" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource CinderAccentDimBrush}"
                                   VerticalAlignment="Bottom" Height="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Always visible: progress while a folder is read, and "nothing matches" are both said here. -->
        <Border Grid.Row="3" Height="26" Padding="14,0"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding StatusLine}" Classes="dim" FontSize="11.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusLine}" />
        </Border>

        <!-- ===== Events ===== -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                  AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding Events.Count}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间戳（UTC）" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="170"
                                    FontFamily="{DynamicResource CinderFontFamilyMono}" FontSize="12.5" />
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="150"
                                    FontFamily="{DynamicResource CinderFontFamilyMono}" FontSize="12.5" />
                <DataGridTextColumn Header="用户" Binding="{Binding User}" Width="120" FontSize="12.5" />
                <DataGridTextColumn Header="ATT&amp;CK" Binding="{Binding TagsDisplay}" Width="110"
                                    FontFamily="{DynamicResource CinderFontFamilyMono}" FontSize="12.5" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" FontSize="12.5" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Empty ===== -->
        <c:EmptyState Grid.Row="4" Icon="{x:Static c:Icons.Clock}" Title="尚无事件"
                      Message="导入一个检材文件夹：可以是分诊采集包、已挂载的镜像，或导出的用户配置文件。Cinder 会读取其中找到的带时间戳的记录，并按时间顺序列出。"
                      IsVisible="{Binding ShowEmptyState}">
            <Button Classes="accent" HorizontalAlignment="Center" Height="30" Padding="14,0"
                    Content="导入文件夹…" Command="{Binding IngestFolderCommand}" />
        </c:EmptyState>

        <!-- Events exist, but the applied dates and filters match none of them. -->
        <c:EmptyState Grid.Row="4" Icon="{x:Static c:Icons.Clock}" Title="没有符合条件的事件"
                      Message="时间线上没有落在这些日期和筛选范围内的事件。放宽日期范围或清除某个筛选，然后按回车。"
                      IsVisible="{Binding ShowNoMatches}" />
    </Grid>
</UserControl>
